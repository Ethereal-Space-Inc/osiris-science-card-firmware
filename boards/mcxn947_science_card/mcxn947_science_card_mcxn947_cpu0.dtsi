/* Common dts file to enable supported features for CPU 0.
 * This file is included by both the default variant
 * which is run from internal flash and the QSPI variant.
 */
/dts-v1/;

#include <nxp/nxp_mcxn94x.dtsi>
#include <zephyr/dt-bindings/i2c/i2c.h>
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/adc/adc.h>
#include <zephyr/dt-bindings/adc/mcux-lpadc.h>
#include <zephyr/dt-bindings/spi/spi.h>
#include <zephyr/dt-bindings/gpio/nxp-kinetis-gpio.h>
#include <zephyr/dt-bindings/pwm/pwm.h>
#include <zephyr/dt-bindings/sensor/rm3100.h>

/ {
	cpus {
		/delete-node/ cpu@1;
	};

	oresat_demo: oresat-demo-enabled {}; /* Enable demos for supported boards */

	chosen {
		zephyr,sram = &sram0;
		zephyr,flash = &flash;
		zephyr,flash-controller = &fmu;
		zephyr,code-partition = &slot0_partition;
		zephyr,uart-mcumgr = &flexcomm4_lpuart4;
		zephyr,console = &flexcomm4_lpuart4;
		zephyr,shell-uart = &flexcomm4_lpuart4;
		zephyr,canbus = &flexcan0;
		zephyr,code-cpu1-partition = &slot1_partition;
		uart,ccc = &flexcomm2_lpuart2;
	};

	aliases{
		led0 = &amber_led;
		watchdog0 = &wwdt0;
		rtc = &rtc;
		adc0 = &lpadc0;
		instr = &flexcomm9_lpuart9;
	};

	leds {
		compatible = "gpio-leds";
		amber_led: led_1 {
			gpios = <&gpio1 13 GPIO_ACTIVE_LOW>;
			label = "Amber LED";
			status = "okay";
		};
	};

	scigpios: sci-gpios {
		compatible = "science-card";
		btldin_1_gpios = <&gpio3 0 GPIO_ACTIVE_HIGH>;	/* out. Set high to boot with the SD card? */
		btldin_0_gpios = <&gpio3 1 GPIO_ACTIVE_HIGH>;	/* out. Set high to boot with the SD card? */
		ocxo_no_en_gpios = <&gpio3 15 GPIO_ACTIVE_LOW>;	/* out. Set high to disable oxco */
		sep_no_en_gpios  = <&gpio3 16 GPIO_ACTIVE_LOW>;	/* out. Set high to disable septentrio */
		pico_no_en_gpios = <&gpio3 17 GPIO_ACTIVE_LOW>;	/* out. Set high to disable picozed */
	};
};

&flexcomm0 {
	status = "okay";
};

&flexcomm2 {
	status = "okay";
};

&flexcomm4 {
	status = "okay";
};

&flexcomm9 {
	status = "okay";
};

&flexcomm2_lpuart2 {
	current-speed = <2000000>;
	pinctrl-0 = <&pinmux_flexcomm2_lpuart>;
	pinctrl-names = "default";
	status = "okay";
};

&flexcomm4_lpuart4 {
	current-speed = <115200>;
	pinctrl-0 = <&pinmux_flexcomm4_lpuart>;
	pinctrl-names = "default";
	status = "okay";
};

&flexcomm9_lpuart9 {
	current-speed = <2000000>;
	pinctrl-0 = <&pinmux_flexcomm9_lpuart>;
	pinctrl-names = "default";
	status = "okay";
};

&flexcan0 {
	pinctrl-0 = <&pinmux_flexcan0>;
	pinctrl-names = "default";
	status = "okay";
};

/*
 * Default for this board is to allocate SRAM0-5 to cpu0 but the
 * application can have an application specific device tree to
 * allocate the SRAM0-7 differently.
 *
 * For example, SRAM0-6 could be allocated to cpu0 with only SRAM7
 * for cpu1. This would require the value of sram0 to have a DT_SIZE_K
 * of 384. You would have to make updates to cpu1 sram settings as well.
 */
&sram0 {
	compatible = "mmio-sram";
	reg = <0x20000000 DT_SIZE_K(320)>;
};

&sram {
	sramg: memory@20050000 {
		compatible = "mmio-sram";
		reg = <0x20050000 DT_SIZE_K(64)>;
	};
	sramh: memory@20060000 {
		compatible = "mmio-sram";
		reg = <0x20060000 DT_SIZE_K(32)>;
	};
};

&flash {
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		/*
		 * Partition sizes must be aligned
		 * to the flash memory sector size of 8KiB.
		 *
		 * There is a 16KiB separation between slot0 and slot1. This replicates the slot
		 * that exists in the mag and template firmware.
		 */
		boot_partition: partition@0 {
			label = "mcuboot";
			reg = <0x00000000 DT_SIZE_K(80)>;
		};
		slot0_partition: partition@14000 {
			label = "image-0";
			reg = <0x00014000 DT_SIZE_K(464)>;
		};
		slot1_partition: partition@8C000 {
			label = "image-1";
			reg = <0x0008C000 DT_SIZE_K(464)>;
		};
		storage_partition: partition@100000 {
			label = "storage";
			reg = <0x00100000 DT_SIZE_K(1024)>;
		};
	};
};

&mbox {
	status = "disabled";
};

&gpio4 {
	status = "okay";
};

&gpio1 {
	status = "okay";
};

&gpio3 {
	status = "okay";
};

&gpio0 {
	status = "okay";
};

&gpio2 {
	status = "okay";
};

&edma0 {
	status = "disabled";
};

&wwdt0 {
	status = "okay";
};

&systick {
	status = "okay";
};

&ctimer0 {
	status = "disabled";
};

&vref {
	status = "okay";
};

&lptmr0 {
	status = "disabled";
};

&flexio0 {
	status = "disabled";
};

&mrt0_channel0 {
	status = "disabled";
};

&rtc {
	status = "okay";
};

&enet {
	status = "disabled";
};

&lpadc0 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinmux_lpadc0>;
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";
	lpadc0_0: channel@0 { /* Current Draw from MAX */
		reg = <0>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_EXTERNAL0";
		zephyr,vref-mv = <3300>;
		zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_MICROSECONDS,2)>;
		zephyr,resolution = <12>;
		zephyr,oversampling = <7>;
		zephyr,input-positive = <MCUX_LPADC_CH0A>;
		/delete-property/ zephyr,differential;
	};
};
