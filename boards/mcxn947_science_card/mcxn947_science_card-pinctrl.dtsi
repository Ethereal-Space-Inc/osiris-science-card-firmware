#include <nxp/mcx/MCXN947VNL-pinctrl.h>

&pinctrl {
/* CDH_COMM */
/* Pin 21/P2_7 (TX) Pin 16/P2_2 (RX) */
/* Think this talks to  */
	pinmux_flexcomm9_lpuart: pinmux_flexcomm9_lpuart {
		group0 {
			pinmux = <FC9_P3_PIO2_2>,
				<FC9_P5_PIO2_7>;
			slew-rate = "fast";
			bias-pull-up;
			drive-strength = "low";
			input-enable;
		};
	};

/* Pins 1 and 2, or P1_8 and P1_9 */
/* UART connection to the backplane/debug connector. */
	pinmux_flexcomm4_lpuart: pinmux_flexcomm4_lpuart { // Done.
		group0 {
			pinmux = <FC4_P0_PIO1_8>,
				<FC4_P1_PIO1_9>;
			slew-rate = "fast";
			bias-pull-up;
			drive-strength = "low";
			input-enable;
		};
	};

/* Pins number 3 and 4, or P1_10 and P1_11. */
/* Connect to CAN2 on the backplane. CAN1 is unconnected. that might be an issue? */
	pinmux_flexcan0: pinmux_flexcan0 { // Done.
		group0 {
			pinmux = <CAN0_TXD_PIO1_10>,
				<CAN0_RXD_PIO1_11>;
			slew-rate = "fast";
			drive-strength = "low";
			input-enable;
		};
	};

	pinmux_lpadc0: pinmux_lpadc0 {
		group0 {
			pinmux = <ADC0_A0_PIO4_0>;
			slew-rate = "fast";
			drive-strength = "low";
		};
	};
};
