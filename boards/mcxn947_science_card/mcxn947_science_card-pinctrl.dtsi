#include <nxp/mcx/MCXN947VNL-pinctrl.h>

&pinctrl {
	pinmux_flexcomm0_lpi2c: pinmux_flexcomm0_lpi2c {
		group0 {
			pinmux = <FC0_P0_PIO0_16>,
				<FC0_P1_PIO0_17>;
			slew-rate = "fast";
			drive-strength = "low";
			input-enable;
			bias-pull-up;
			drive-open-drain;
		};
	};

/* SEP_COMM */
/* Pin 20/P2_6 (RX) Pin 14/P2_0 (TX) */
/* Does this talk to the septentrio? */
	pinmux_flexcomm4_lpuart: pinmux_flexcomm4_lpuart { // TODO AAAAAAAAAA
		group0 {
			pinmux = <FC4_P0_PIO1_8>, // UNTOUCHED. FIX.
				<FC4_P1_PIO1_9>;
			slew-rate = "fast";
			bias-pull-up;
			drive-strength = "low";
			input-enable;
		};
	};

/* PPS */
/* Pin 19/P2_5 (IN) Pin 15/P2_1 (OUT) */
/* Unclear what this does, or how ot handle it. */
	pinmux_flexcomm4_lpuart: pinmux_flexcomm4_lpuart { // TODO AAAAAAAAAA
		group0 {
			pinmux = <FC4_P0_PIO1_8>, // UNTOUCHED. FIX.
				<FC4_P1_PIO1_9>;
			slew-rate = "fast";
			bias-pull-up;
			drive-strength = "low";
			input-enable;
		};
	};

/* CDH_COMM */
/* Pin 21/P2_7 (RX) Pin 16/P2_2 (TX) */
/* Unclear what this does, or how ot handle it. */
	pinmux_flexcomm4_lpuart: pinmux_flexcomm4_lpuart { // TODO AAAAAAAAAA
		group0 {
			pinmux = <FC4_P0_PIO1_8>, // UNTOUCHED. FIX.
				<FC4_P1_PIO1_9>;
			slew-rate = "fast";
			bias-pull-up;
			drive-strength = "low";
			input-enable;
		};
	};

/* Pins 1 and 2, or P1_8 and P1_9 */
/* UART connection to the backplane. */
	pinmux_flexcomm4_lpuart: pinmux_flexcomm4_lpuart { // Done.
		group0 {
			pinmux = <FC4_P0_PIO1_8>,
				<FC4_P1_PIO1_9>;
			slew-rate = "fast";
			bias-pull-up;
			drive-strength = "low";
			input-enable;
		};
	};

/* Pins number 3 and 4, or P1_10 and P1_11. */
/* Connect to CAN2 on the backplane. CAN1 is unconnected. that might be an issue? */
	pinmux_flexcan0: pinmux_flexcan0 { // Done.
		group0 {
			pinmux = <CAN0_TXD_PIO1_10>,
				<CAN0_RXD_PIO1_11>;
			slew-rate = "fast";
			drive-strength = "low";
			input-enable;
		};
	};
